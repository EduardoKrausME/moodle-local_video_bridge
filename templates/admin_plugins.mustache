{{!
    @template local_video_bridge/admin_plugins

    Example context (json):
    {
        "title": "Video sources",
        "description": "Shared video source adapters used by Moodle video plugins.",
        "hasplugins": true,
        "plugins": [
            {
                "name": "YouTube",
                "component": "videoprogresssource_youtube",
                "version": "2026100500",
                "release": "1.0",
                "status": "Installed and up to date",
                "settingsurl": "/admin/settings.php?section=videoprogresssource_youtube",
                "uninstallurl": "/admin/plugins.php?uninstall=videoprogresssource_youtube",
                "canuninstall": true
            }
        ],
        "componentlabel": "Component",
        "versionlabel": "Internal version",
        "releaselabel": "Release version",
        "statuslabel": "Status",
        "settingslabel": "Settings",
        "uninstalllabel": "Uninstall",
        "inuselabel": "In use or required",
        "emptytitle": "No video sources installed",
        "emptydescription": "Install at least one compatible video source subplugin."
    }
}}

<section class="video-bridge-admin-plugins" aria-labelledby="video-bridge-admin-plugins-title">
    <header class="mb-4">
        <h2 id="video-bridge-admin-plugins-title" class="h3 mb-2">{{{title}}}</h2>
        <p class="text-muted mb-0">{{{description}}}</p>
    </header>

    {{#hasplugins}}
        <div class="row g-3">
            {{#plugins}}
                <div class="col-12 col-lg-6">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title">{{{name}}}</h3>
                            <dl class="row small mb-3">
                                <dt class="col-5">{{{componentlabel}}}</dt>
                                <dd class="col-7"><code>{{{component}}}</code></dd>
                                <dt class="col-5">{{{versionlabel}}}</dt>
                                <dd class="col-7">{{{version}}}</dd>
                                <dt class="col-5">{{{releaselabel}}}</dt>
                                <dd class="col-7">{{{release}}}</dd>
                                <dt class="col-5">{{{statuslabel}}}</dt>
                                <dd class="col-7">{{{status}}}</dd>
                            </dl>
                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                {{#settingsurl}}
                                    <a class="btn btn-secondary" href="{{{settingsurl}}}">{{{settingslabel}}}</a>
                                {{/settingsurl}}
                                {{#uninstallurl}}
                                    <a class="btn btn-outline-danger" href="{{{uninstallurl}}}">{{{uninstalllabel}}}</a>
                                {{/uninstallurl}}
                                {{^canuninstall}}
                                    <span class="badge bg-light text-dark border align-self-center">{{{inuselabel}}}</span>
                                {{/canuninstall}}
                            </div>
                        </div>
                    </article>
                </div>
            {{/plugins}}
        </div>
    {{/hasplugins}}

    {{^hasplugins}}
        <div class="alert alert-info" role="status">
            <h3 class="h5 alert-heading">{{{emptytitle}}}</h3>
            <p class="mb-0">{{{emptydescription}}}</p>
        </div>
    {{/hasplugins}}
</section>
